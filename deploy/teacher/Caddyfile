# The teacher app and the lesson domain on one box. Two registrable domains, so nothing published shares cookies or
# storage with teachers' sessions. Replace the two names; Caddy gets their certificates.

lehrer.example.de {
	encode zstd gzip
	handle /api/* {
		reverse_proxy 127.0.0.1:7740
	}
	handle {
		root * /opt/gestalts-teacher/current/app
		try_files {path} /index.html
		file_server
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
	}
}

lektion.example.net {
	encode zstd gzip
	reverse_proxy 127.0.0.1:7741
	header Strict-Transport-Security "max-age=31536000"
}
